def hive_home():
    return Path(os.environ.get("HIVE_HOME") or DEFAULT_HIVE_HOME).expanduser()


def launch_token_path():
    return hive_home() / LAUNCH_FILE


def write_launch_token(path=None):
    """A fresh random launch token, in a 0600 file made 0600 from the first byte (so no other OS account can read it)
    and swapped in atomically. Returns the token. Only an account that can read this file can obtain the CSRF token."""
    path = Path(path or launch_token_path())
    token = secrets.token_urlsafe(32)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(token + "\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return token


def read_launch_token(path=None):
    """The token `serve` wrote, or None when the file is missing, not ours, or readable by anyone else."""
    try:
        p = Path(path or launch_token_path())
        st = p.lstat()
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
            return None
        return p.read_text().strip() or None
    except (OSError, ValueError):
        return None


def write_open_page(url, path=None):
    """A 0600 page that redirects to `url` (which carries the launch token in its fragment), made 0600 from the first
    byte and swapped in atomically. The browser is given only this file's path: a command line is readable by every
    account via /proc/<pid>/cmdline, the file is not."""
    path = Path(path or hive_home() / OPEN_FILE)
    quoted = json.dumps(url).replace("<", "\\u003c")
    page = ('<!doctype html><meta charset="utf-8"><title>HiveMind dashboard</title>'
            f'<script>location.replace({quoted})</script>'
            f'<noscript><a href={quoted}>Open the dashboard</a></noscript>\n')
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(page)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return path


def remove_open_page_later(path, delay=OPEN_TTL):
    """Best effort: a detached shell removes the page after `delay` seconds (the next `hv dash` overwrites it anyway)."""
    try:
        subprocess.Popen(["sh", "-c", 'sleep "$1"; rm -f -- "$2"', "sh", str(delay), str(path)], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def module_dir():
    return Path(os.environ.get("HIVE_MODULE_DIR") or HERE)


def load_port(path=None):
    """The `port` config key (a per-node JSON file the core keeps), else the default. A bad value is the default."""
    try:
        have = json.loads((path or module_dir() / "config").read_text())
        port = int(have["port"])
        if 1024 <= port <= 65535:
            return port
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return PORT_DEFAULT


def daemon_port():
