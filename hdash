#!/usr/bin/env python3
"""hdash: the HiveMind dashboard as a module (extracted unchanged from hive-mind's `dashboard/`).

  hdash serve        the module service: a loopback HTTP server for the dashboard page and its `/api/*` reads
  hdash dash [--print]   print the dashboard URL and open it in a browser (what `hv dash` forwards to)

`serve` answers on 127.0.0.1 for a request whose Host is the loopback address it is bound to. It has no write route;
every non-GET request still has to pass the Host and Origin checks and carry the CSRF token (`/api/csrf`) before a
route is even looked up (P3), so the first write lands behind the guard.
The page's `/api/*` calls are mapped to the core's read routes:

  overview, tags, related, audit, peers, verify, search, item   -> signed `GET /v1/<route>` (the module API;
                                                                     the manifest's `reads` names them)
  status, telemetry, entities, and any call with `?node=<peer>` -> the sync daemon's loopback `/api/<route>`
                                                                     (which also does the signed per-node proxy)
  modules, module                                               -> answered here, for this node only (no `?node=`):
                                                                     `hive-mind module list --json` plus the core's
                                                                     doctor cache; a web request never starts module code

Nothing is written to the hive and no owner key is touched. Standard library only; the core's module client is
imported from the core checkout (`HIVE_HOME`) so there is one Ed25519 in the system.
"""

import argparse
import base64
import hmac
import json
import os
import re
import secrets
import shlex
import shutil
import stat
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlencode, urlparse

BIND = "127.0.0.1"
PORT_DEFAULT = 9896            # config key `port`; the sync daemon is 9876 and the module API 9886
DAEMON_PORT_DEFAULT = 9876
DEFAULT_HIVE_HOME = "~/projects/hive-mind"
MAX_CONCURRENT = 8
CSP = "default-src 'self'"
HERE = Path(__file__).resolve().parent
STATIC = {
    "index.html": "text/html; charset=utf-8",
    "app.js": "text/javascript; charset=utf-8",
    "app.css": "text/css; charset=utf-8",
    "logo.svg": "image/svg+xml",
    "favicon.svg": "image/svg+xml",
}
PAGES = {"/": "index.html", "/index.html": "index.html", "/dashboard": "index.html", "/dashboard/": "index.html",
         "/logo.svg": "logo.svg", "/favicon.svg": "favicon.svg", "/app.js": "app.js", "/app.css": "app.css"}
V1_READS = ("overview", "tags", "related", "audit", "peers", "verify", "search", "item")
DAEMON_ONLY = ("status", "telemetry", "entities")
LOCAL_ROUTES = ("modules", "module")     # answered by hdash itself (Settings > Modules and the module page), this node only
API_ROUTES = V1_READS + DAEMON_ONLY + LOCAL_ROUTES
MODULE_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,39}\Z")
DOCTOR_CACHE_DIR = ".module-doctor"      # the core's cache beside the hive (hive_modules.DOCTOR_CACHE_DIR)
DOCTOR_LEVELS = ("ok", "warn", "fail")
DOCTOR_MAX_BYTES, DOCTOR_MAX_RESULTS, TEXT_MAX = 256 * 1024, 100, 400
MANIFEST_MAX_BYTES = 1024 * 1024
CSRF_HEADER = "X-HDash-CSRF"
CSRF_ROUTE = "/api/csrf"
MAX_BODY = 64 * 1024


def hive_home():
    return Path(os.environ.get("HIVE_HOME") or DEFAULT_HIVE_HOME).expanduser()


def module_dir():
    return Path(os.environ.get("HIVE_MODULE_DIR") or HERE)


def load_port(path=None):
    """The `port` config key (a per-node JSON file the core keeps), else the default. A bad value is the default."""
    try:
        have = json.loads((path or module_dir() / "config").read_text())
        port = int(have["port"])
        if 1024 <= port <= 65535:
            return port
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return PORT_DEFAULT


def daemon_port():
    try:
        return int(json.loads((hive_home() / ".peers.json").read_text()).get("port", DAEMON_PORT_DEFAULT))
    except (OSError, ValueError, TypeError):
        return DAEMON_PORT_DEFAULT


def make_v1_client():
    """A `hive_module_client.ModuleClient` for this module's admitted device key (as hwatch does)."""
    home = hive_home()
    if not (home / "hive_module_client.py").is_file():
        raise RuntimeError(f"no hive-mind core at {home} (no hive_module_client.py): set HIVE_HOME")
    key_dir = os.environ.get("HIVE_MODULE_KEY_DIR")
    if not key_dir:
        raise RuntimeError("HIVE_MODULE_KEY_DIR is not set: run hdash as an installed module")
    try:
        seed = base64.b64decode((Path(key_dir) / "device-key").read_text().strip(), validate=True)
    except (OSError, ValueError) as e:
        raise RuntimeError(f"cannot read the module key in {key_dir}: {e}") from e
    if len(seed) != 32:
        raise RuntimeError(f"the module key in {key_dir} is not a 32-byte seed")
    if str(home) not in sys.path:
        sys.path.insert(0, str(home))
    import hive_module_client
    port = os.environ.get("HIVE_MODULE_PORT")
    return hive_module_client.ModuleClient(seed, port=int(port)) if port else hive_module_client.ModuleClient(seed)


def daemon_get(path, query, port, timeout=30):
    """GET the sync daemon's loopback `/api/*`: (status, parsed JSON). The daemon does the per-node proxy."""
    url = f"http://127.0.0.1:{port}{path}" + (f"?{query}" if query else "")
    req = urllib.request.Request(url, headers={"Host": f"127.0.0.1:{port}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read())
        except ValueError:
            return e.code, {"error": "daemon error"}


def modules_dir():
    return Path(os.environ.get("HIVE_MODULES_DIR") or Path.home() / ".hive" / "modules")


def clean_text(value, limit=TEXT_MAX):
    """Text from a module or a cache file: control, format (bidi, zero-width) and line-break characters out,
    whitespace made plain, at most `limit` characters. The page renders it as text, never as markup."""
    out = []
    for ch in str(value):
        cat = unicodedata.category(ch)
        if ch in "\t\n\r":
            out.append(" ")
        elif cat not in ("Cc", "Cf", "Zl", "Zp"):
            out.append(ch)
    return "".join(out)[:limit]


def read_doctor_cache(home, name, now=None):
    """`<home>/.module-doctor/<name>.json` as the core wrote it, with its age, or None. Reads a file and runs nothing.
    Like the core's reader it refuses a link, a directory or file that is not the operator's, a group- or
    world-writable directory, an over-large file and a wrong shape, and it cleans every string again."""
    if not MODULE_NAME.match(name):
        return None
    d = Path(home) / DOCTOR_CACHE_DIR
    try:
        dst = os.lstat(d)
        if not (stat.S_ISDIR(dst.st_mode) and dst.st_uid == os.getuid() and not dst.st_mode & 0o022):
            return None
        path = d / f"{name}.json"
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_size > DOCTOR_MAX_BYTES:
            return None
        doc = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict):
        return None
    at = doc.get("at")
    if not (doc.get("schema") == 1 and isinstance(at, int) and not isinstance(at, bool) and isinstance(doc.get("results"), list)):
        return None
    results = []
    for r in doc["results"][:DOCTOR_MAX_RESULTS]:
        if (isinstance(r, dict) and r.get("level") in DOCTOR_LEVELS and isinstance(r.get("check"), str)
                and isinstance(r.get("message"), str) and isinstance(r.get("fix_hint", ""), str)):
            row = {"level": r["level"], "check": clean_text(r["check"]), "message": clean_text(r["message"])}
            if r.get("fix_hint"):
                row["fix_hint"] = clean_text(r["fix_hint"])
            results.append(row)
    now = time.time() if now is None else now
    return {"at": at, "age_s": max(0, int(now - at)), "version": clean_text(doc.get("version", ""), 64),
            "worst": max((r["level"] for r in results), key=DOCTOR_LEVELS.index, default="ok"), "results": results}


def hive_mind_argv():
    """The control-plane command: `hive-mind` on PATH, else the core checkout's own entry point."""
    exe = shutil.which("hive-mind")
    return [exe] if exe else [sys.executable, "-I", str(hive_home() / "hivemind_ctl.py")]


def list_modules(timeout=20):
    """`hive-mind module list --json` rows (argv, no shell, no stdin). Raises RuntimeError saying why not."""
    try:
        p = subprocess.run(hive_mind_argv() + ["module", "list", "--json"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=timeout)
        doc = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        raise RuntimeError(f"cannot list modules: {e}") from e
    rows = doc.get("modules") if isinstance(doc, dict) and p.returncode == 0 else None
    if not isinstance(rows, list):
        raise RuntimeError(f"`hive-mind module list --json` failed (exit {p.returncode})")
    return [r for r in rows if isinstance(r, dict) and MODULE_NAME.match(str(r.get("name", "")))]


def _row_view(row):
    keys = ("name", "version", "publisher", "signature", "service", "device", "trust", "quota_use", "problem", "config_schema")
    return {k: clean_text(row[k], 200) if isinstance(row.get(k), str) else row.get(k) for k in keys if k in row}


def modules_view(rows=None, home=None, now=None):
    """Settings > Modules: the catalog and each module's cached health with its age. Read-only."""
    rows = list_modules() if rows is None else rows
    home = home or hive_home()
    return {"schema": 1, "modules": [{**_row_view(r), "doctor": read_doctor_cache(home, r["name"], now)} for r in rows]}


# The core's placeholder grammar (hive_modules._PLACEHOLDER): `{role2}` is legal.
_PLACEHOLDER = re.compile(r"\{([a-z][a-z0-9_]*)\}")


def _argv_line(argv):
    """An action's argv template as one copyable command line. `{param}` shows as `<param>`; a token with one is
    double-quoted with the shell's specials escaped, any other token is shell-quoted."""
    out = []
    for tok in argv:
        if _PLACEHOLDER.search(tok):
            tok = _PLACEHOLDER.sub(r"<\1>", tok)
            out.append('"' + re.sub(r'([\\"$`])', r"\\\1", tok) + '"')
        else:
            out.append(shlex.quote(tok))
    return " ".join(out)


def ui_view(manifest):
    """The part of a manifest's `ui` block the module page shows: title, summary and the declared actions as
    commands to copy. The core validated the block at install; this still takes only strings and short lists."""
    ui = manifest.get("ui")
    if not isinstance(ui, dict):
        return None
    out = {"title": clean_text(ui.get("title", ""), 80), "summary": clean_text(ui.get("summary", ""), 200), "actions": []}
    for a in (ui.get("actions") if isinstance(ui.get("actions"), list) else [])[:20]:
        argv = a.get("command") if isinstance(a, dict) else None
        if not (isinstance(argv, list) and argv and all(isinstance(t, str) for t in argv)):
            continue
        out["actions"].append({"id": clean_text(a.get("id", ""), 40), "label": clean_text(a.get("label", ""), 80),
                               "command": clean_text(_argv_line(argv), 600), "confirm": clean_text(a.get("confirm", ""), 200),
                               "owner": a.get("owner") is True})
    return out


def read_manifest(name, base=None):
    """The installed `module.json` as a dict, or {}. Size-capped, regular file only; the caller decides whether the
    core vouches for it (the row's `signature`)."""
    path = (base or modules_dir()) / name / "module.json"
    try:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_size > MANIFEST_MAX_BYTES:
            return {}
        doc = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return doc if isinstance(doc, dict) else {}


def module_view(name, rows=None, home=None, now=None, base=None):
    """The generic module page: its catalog row, cached health and, only when the core reports its signature
    `valid`, the `ui` block it declares. None if no such module."""
    if not MODULE_NAME.match(name):
        return None
    rows = list_modules() if rows is None else rows
    row = next((r for r in rows if r.get("name") == name), None)
    if row is None:
        return None
    out = {"schema": 1, "module": {**_row_view(row), "doctor": read_doctor_cache(home or hive_home(), name, now)}, "ui": None}
    if row.get("signature") == "valid":
        manifest = read_manifest(name, base)
        out["ui"] = ui_view(manifest)
        out["module"]["cli"] = clean_text((manifest.get("cli") or {}).get("name", ""), 40) if isinstance(manifest.get("cli"), dict) else ""
    return out


def local_routes():
    def modules(query):
        try:
            return 200, modules_view()
        except RuntimeError as e:
            return 502, {"error": str(e)}

    def module(query):
        name = parse_qs(query).get("name", [""])[0]
        try:
            view = module_view(name)
        except RuntimeError as e:
            return 502, {"error": str(e)}
        return (200, view) if view else (404, {"error": "no such module"})
    return {"modules": modules, "module": module}


class Gateway:
    """Maps one dashboard `/api/<route>` call to the core. `v1` is a callable (path, query) -> (status, obj),
    `daemon` the same for the daemon's `/api/*`. Both are injected so tests need no live core."""

    def __init__(self, v1, daemon, local=None, writes=None):
        self.v1, self.daemon, self.local = v1, daemon, local or {}
        self.writes = writes or {}          # name -> callable(obj) -> (status, obj); none exist yet (P3 guards them first)

    def write(self, name, obj):
        fn = self.writes.get(name)
        return fn(obj) if fn else (405, {"error": "read only"})

    def route(self, name, query):
        if name in LOCAL_ROUTES:                     # this node's own catalog: `?node=` is not forwarded
            fn = self.local.get(name)
            return fn(query) if fn else (404, {"error": "not found"})
        qs = parse_qs(query)
        if name in V1_READS and not qs.get("node", [""])[0]:
            if name == "item":                       # /api/item takes `sid`, /v1/item takes `id`
                query = urlencode({"id": qs.get("sid", [""])[0]})
            try:
                return self.v1(f"/v1/{name}", query)
            except Exception as e:
                return 502, {"error": f"module API unavailable: {e}"}
        try:
            return self.daemon(f"/api/{name}", query)
        except Exception as e:
            return 502, {"error": f"sync daemon unavailable: {e}"}


def make_handler(gateway, port, csrf_token=None):
    """`csrf_token` is fixed only by tests; a server makes its own per process. Every non-GET route passes, in
    order, the Host check (DNS rebinding), an `Origin` equal to this listener's own origin (required, not optional),
    `Sec-Fetch-Site: same-origin` when the browser sends one, the CSRF token header (constant-time compare), a JSON
    content type and a bounded JSON object body. Only then is a write route looked up, so a probe that fails any
    check learns nothing about which writes exist."""
    allowed = {f"127.0.0.1:{port}", f"localhost:{port}", f"[::1]:{port}"}
    origins = {f"http://{h}" for h in allowed}
    token = csrf_token or secrets.token_urlsafe(32)
    slots = __import__("threading").BoundedSemaphore(MAX_CONCURRENT)

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "hdash"

        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json", extra=()):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Cache-Control", "no-store")
            for k, v in extra:
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)

        def _refuse(self, code, msg):
            self._send(code, {"error": msg}, extra=(("Allow", "GET, HEAD"),) if code == 405 else ())

        def _origin_ok(self, mutating):
            origin = self.headers.get("Origin")
            if origin is None:
                return not mutating                      # a write must say where it came from
            return origin.lower() in origins             # a stray or `null` Origin fails on any method

        def _site_ok(self, mutating):
            site = self.headers.get("Sec-Fetch-Site")
            return site is None or site == "same-origin" or (site == "none" and not mutating)

        def _serve(self):
            if (self.headers.get("Host") or "").lower() not in allowed:
                return self._refuse(403, "forbidden host")          # DNS rebinding: only the loopback name
            if not self._origin_ok(False) or not self._site_ok(False):
                return self._refuse(403, "forbidden origin")
            u = urlparse(self.path)
            if u.path == CSRF_ROUTE:
                return self._send(200, {"token": token})
            if u.path in PAGES:
                name = PAGES[u.path]
                try:
                    body = (HERE / "dashboard" / name).read_bytes()
                except OSError:
                    return self._refuse(404, "dashboard asset missing")
                extra = (("Content-Security-Policy", CSP),) if name == "index.html" else ()
                return self._send(200, body, STATIC[name], extra)
            if u.path.startswith("/api/") and u.path[5:] in API_ROUTES:
                code, obj = gateway.route(u.path[5:], u.query)
                return self._send(code, obj)
            self._refuse(404, "not found")

        def _guarded(self):
            if not slots.acquire(blocking=False):
                return self._refuse(503, "server busy")
            try:
                self._serve()
            except Exception as e:  # never crash the handler thread
                self._refuse(500, str(e))
            finally:
                slots.release()

        do_GET = do_HEAD = _guarded

        def _no(self):
            self._refuse(405, "read only")

        do_OPTIONS = _no                                  # no CORS: a cross-origin preflight is never answered yes

        def _deny(self, code, msg):
            self.close_connection = True                  # the body was not read: do not parse it as the next request
            self._send(code, {"error": msg}, extra=(("Connection", "close"),) + ((("Allow", "GET, HEAD"),) if code == 405 else ()))

        def _mutate(self):
            if (self.headers.get("Host") or "").lower() not in allowed:
                return self._deny(403, "forbidden host")
            if not self._origin_ok(True) or not self._site_ok(True):
                return self._deny(403, "forbidden origin")
            if not hmac.compare_digest((self.headers.get(CSRF_HEADER) or "").encode(), token.encode()):
                return self._deny(403, "missing or wrong CSRF token")
            if (self.headers.get("Content-Type") or "").split(";")[0].strip().lower() != "application/json":
                return self._deny(415, "JSON only")
            try:
                n = int(self.headers.get("Content-Length") or "")
            except ValueError:
                return self._deny(411, "Content-Length required")
            if not 0 <= n <= MAX_BODY:
                return self._deny(413, "body too large")
            try:
                obj = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                return self._deny(400, "bad JSON")
            if not isinstance(obj, dict):
                return self._deny(400, "JSON object required")
            u = urlparse(self.path)
            if not u.path.startswith("/api/"):
                return self._deny(404, "not found")
            code, out = gateway.write(u.path[5:], obj)
            self._send(code, out)

        def _guarded_write(self):
            if not slots.acquire(blocking=False):
                return self._deny(503, "server busy")
            try:
                self._mutate()
            except Exception as e:
                self._deny(500, str(e))
            finally:
                slots.release()

        do_POST = do_PUT = do_DELETE = do_PATCH = _guarded_write

    return Handler


def make_server(gateway, port):
    return ThreadingHTTPServer((BIND, port), make_handler(gateway, port))


def cmd_serve(args):
    port = load_port()
    try:
        client = make_v1_client()
    except RuntimeError as e:
        print(f"hdash: {e}", file=sys.stderr)
        return 1
    dport = daemon_port()
    gateway = Gateway(lambda p, q: client.request("GET", p, q),
                      lambda p, q: daemon_get(p, q, dport), local_routes())
    srv = make_server(gateway, port)
    print(f"hdash: serving http://127.0.0.1:{port}/", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def cmd_dash(args):
    port = load_port()
    local = f"http://127.0.0.1:{port}/"
    up = False
    try:
        urllib.request.urlopen(local + "app.css", timeout=2).close()
        up = True
    except Exception:
        pass
    print("HiveMind dashboard")
    print(f"  Local:    {local}")
    if not up:
        print("\n  ⚠ The hdash service isn't answering on this port — the dashboard won't load yet.")
        print("    Check it with `hive-mind module status hdash`, then retry `hv dash`.")
        return 1
    if args.print_only:
        return 0
    opener = next(([c] for c in ("termux-open-url", "xdg-open", "open") if shutil.which(c)), None)
    if opener:
        try:
            subprocess.Popen(opener + [local], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print("\n  Opening in your browser…")
            return 0
        except OSError:
            pass
    print("\n  (Couldn't auto-open a browser — open the Local URL above.)")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="hdash", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve", help="run the dashboard service (the module unit does this)")
    d = sub.add_parser("dash", help="print the dashboard URL and open it in a browser")
    d.add_argument("--print", dest="print_only", action="store_true", help="print the URL only; do not open a browser")
    args = p.parse_args(argv)
    return {"serve": cmd_serve, "dash": cmd_dash}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
