    "trust": {"title": "Trust", "question": "Is this install genuine, and can I verify each claim?", "empty": {}},
}
STATUS_TTL = 20            # seconds a module's status envelope is reused: a page reload must not rerun module code
STATUS_MAX_BYTES = 64 * 1024
PANEL_ROWS, PANEL_COLS, SCRUB_DEPTH = 100, 16, 5
PATH_RE = re.compile(r"[A-Za-z0-9_]+(\[\*\])?(\.[A-Za-z0-9_]+(\[\*\])?)*\Z")
# The Trust page's claims, each with the command that proves it (design §3.1 "verify at").
TRUST_CLAIMS = (
    ("This install is the official source", "hv verify"),
    ("Each module's manifest is signed and its files match", "hive-mind module list"),
    ("A module's publisher key is the one pinned at install", "hive-mind module list --json"),
    ("The journal is append-only and every entry is signed", "hv audit"),
    ("The owner key is not on this device unless you unlocked it", "hive-mind owner status"),
    ("Every installed module is healthy", "hv doctor"),
)
_status_cache = {}
_status_lock = __import__("threading").Lock()


def eval_path(doc, path):
    """The contract's JSONPath subset (`a.b`, `a[*].b`, no expressions): the value there, a list when `[*]` is used,
    or None. Anything else is None."""
    if not isinstance(path, str) or not PATH_RE.match(path):
        return None
    cur = [doc]
    fan = False
    for part in path.split("."):
        star = part.endswith("[*]")
        key = part[:-3] if star else part
        nxt = []
        for c in cur:
            if isinstance(c, dict) and key in c:
                v = c[key]
                if star:
                    nxt.extend(v[:PANEL_ROWS * 4] if isinstance(v, list) else [])
                else:
                    nxt.append(v)
        fan = fan or star
        cur = nxt
        if not cur:
            return None
    return cur if fan else cur[0]


def scrub(v, depth=SCRUB_DEPTH):
    """Module data for the page: strings cleaned, collections and depth bounded, nothing but JSON scalars."""
    if isinstance(v, str):
        return clean_text(v, 300)
    if isinstance(v, (bool, int, float)) or v is None:
        return v
    if depth <= 0:
        return None
    if isinstance(v, list):
        return [scrub(x, depth - 1) for x in v[:PANEL_ROWS]]
    if isinstance(v, dict):
        return {clean_text(k, 64): scrub(x, depth - 1) for k, x in list(v.items())[:50]}
    return None


def module_status_envelope(name, now=None):
    """`hive-mind module status NAME --json`: the core's runner executes the manifest's `status` argv with a narrow
    environment and a 20 s limit, and this returns its envelope, or None. Reused for STATUS_TTL seconds."""
    now = time.time() if now is None else now
    with _status_lock:
        hit = _status_cache.get(name)
        if hit and now - hit[0] < STATUS_TTL:
            return hit[1]
        try:
            p = subprocess.run(hive_mind_argv() + ["module", "status", name, "--json"], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=30)
            doc = json.loads(p.stdout[:STATUS_MAX_BYTES]) if len(p.stdout) <= STATUS_MAX_BYTES else None
        except (OSError, ValueError, subprocess.SubprocessError):
            doc = None
        doc = doc if isinstance(doc, dict) else None
        _status_cache[name] = (now, doc)
        return doc


def _panel_data(panel, envelope, doctor):
    """The data of one declared panel, from the sources a workspace reads (`status`, `doctor`); None with a note
    when it names a source this page does not read."""
    src = panel.get("from")
    if src == "status":
        if envelope is None:
            return None, "the module's status did not answer"
        path = panel.get("path")
        val = eval_path(envelope, path) if path else envelope
        if val is None and path:
            val = eval_path(envelope.get("detail") if isinstance(envelope.get("detail"), dict) else {}, path)
        return scrub(val), "" if val is not None else "no data at that path"
    if src == "doctor":
        return (scrub(doctor["results"]) if doctor else None), "" if doctor else "no cached doctor result"
    return None, f"a {clean_text(src, 20)} source is shown on the module's own page"


def slot_panels(row, slot, envelope_fn, home, base=None, now=None):
    """The panels of one signature-valid module for `slot`, resolved from its `ui` block: [] when it declares none.
    Status runs (cached) only for a module that declares a panel reading it."""
    if row.get("signature") != "valid":
        return []
    ui = read_manifest(row["name"], base).get("ui")
    if not isinstance(ui, dict) or not isinstance(ui.get("slots"), dict):
        return []
    ids = ui["slots"].get(slot)
    panels = {p.get("id"): p for p in ui.get("panels", []) if isinstance(p, dict)} if isinstance(ui.get("panels"), list) else {}
    out = []
    for pid in (ids if isinstance(ids, list) else [])[:32]:
        panel = panels.get(pid)
        if not (isinstance(panel, dict) and isinstance(pid, str)):
            continue
        envelope = envelope_fn(row["name"]) if panel.get("from") == "status" else None
        data, note = _panel_data(panel, envelope, read_doctor_cache(home, row["name"], now))
        cols = panel.get("columns") if isinstance(panel.get("columns"), list) else []
        out.append({"module": row["name"], "id": clean_text(pid, 32), "title": clean_text(panel.get("title", pid), 80),
                    "widget": clean_text(panel.get("widget", ""), 32), "unit": "",
                    "columns": [clean_text(c, 64) for c in cols[:PANEL_COLS] if isinstance(c, str)], "data": data, "note": note})
    return out


def workspace_view(name, rows=None, home=None, envelope_fn=None, base=None, now=None):
    """`/api/workspace?name=agents|trust`. Read-only, this node only. None for an unknown workspace."""
    ws = WORKSPACES.get(name)
    if ws is None:
        return None
    rows = list_modules() if rows is None else rows
    home = home or hive_home()
    fn = envelope_fn or module_status_envelope
    panels = [p for r in rows for p in slot_panels(r, name, fn, home, base, now)]
    out = {"schema": 1, "name": name, "title": ws["title"], "question": ws["question"], "panels": panels,
           "notes": [ws["empty"][m] for m in sorted(ws["empty"]) if not any(p["module"] == m for p in panels)]}
    if name == "trust":
        out["modules"] = [{**{k: v for k, v in _row_view(r).items() if k in ("name", "version", "publisher", "signature", "trust", "problem")},
                           "doctor": read_doctor_cache(home, r["name"], now)} for r in rows]
        out["claims"] = [{"claim": c, "verify": v} for c, v in TRUST_CLAIMS]
    return out


def hconfig_argv():
    """The `hconfig` command on PATH. Raises RuntimeError saying how to install it when it is missing."""
    exe = shutil.which("hconfig")
    if not exe:
        raise RuntimeError("hconfig is not installed on this node: hive-mind module add hconfig")
    return [exe]


def run_hconfig(args, stdin_text=None, timeout=HCONFIG_TIMEOUT):
    """Run `hconfig <args>` (argv, no shell): (exit code, parsed JSON object). A value goes in `stdin_text`, never in
    `args`. The owner variables are gone from the child's environment, and `HCONFIG_SOURCE=hdash` marks its audit line."""
    env = {k: v for k, v in os.environ.items() if k not in OWNER_ENV}
    env["HCONFIG_SOURCE"] = "hdash"
    try:
        p = subprocess.run(hconfig_argv() + list(args), input=stdin_text, capture_output=True, text=True, env=env,
                           stdin=None if stdin_text is not None else subprocess.DEVNULL, timeout=timeout)
        doc = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        raise RuntimeError(f"hconfig did not answer: {type(e).__name__}") from e
    if not isinstance(doc, dict):
        raise RuntimeError(f"hconfig did not answer (exit {p.returncode})")
    return p.returncode, doc


def _value_view(v):
    return clean_text(v, 400) if isinstance(v, str) else (v if isinstance(v, (bool, int, float)) or v is None else
                                                            [clean_text(x, 200) for x in v[:100]] if isinstance(v, list) else None)


def record_view(rec):
    """One hconfig record as the forms render it: the known fields only, every string cleaned, and a secret's value
    never shown whatever hconfig sent."""
    out = {}
    for k in RECORD_KEYS:
        if k not in rec:
            continue
        v = rec[k]
        if k in ("warnings",):
            out[k] = [clean_text(w, 300) for w in v[:10]] if isinstance(v, list) else []
        elif k == "set_by":
            out[k] = ({kk: clean_text(v.get(kk, ""), 80) for kk in ("device_id", "ts", "sid")} if isinstance(v, dict) else None)
        elif k == "values":
            out[k] = [clean_text(x, 100) for x in v[:100]] if isinstance(v, list) else []
        else:
            out[k] = _value_view(v)
    if out.get("secret") is True:
        out["value"] = "********" if out.get("set") else None
    return out


def settings_view(query):
    """`hconfig list [PREFIX] [--class C] --json` as records for the forms. Raises RuntimeError saying why not."""
    qs = parse_qs(query)
    prefix, cls = qs.get("prefix", [""])[0], qs.get("class", [""])[0]
    if not SETTING_PREFIX.match(prefix) or cls not in ("",) + SETTING_CLASSES:
        return 400, {"error": "bad prefix or class"}
    rc, doc = run_hconfig(["list", "--json"] + (["--class", cls] if cls else []) + (["--", prefix] if prefix else []))
    if rc != 0 or doc.get("ok") is not True or not isinstance(doc.get("keys"), list):
        err = doc.get("error") if isinstance(doc.get("error"), dict) else {}
        return 502, {"error": clean_text(err.get("message") or f"hconfig list failed (exit {rc})", 200)}
    warns = doc.get("warnings") if isinstance(doc.get("warnings"), list) else []
    return 200, {"schema": 1, "keys": [record_view(r) for r in doc["keys"] if isinstance(r, dict)],
                 "warnings": [clean_text(w, 300) for w in warns[:20]]}


_write_lock = threading.Lock()     # one settings write at a time (hconfig also holds its own flock)


def write_setting(obj):
    """`POST /api/settings` {id, value}: run `hconfig set` with the value on stdin. The caller (the handler) has already
    passed the loopback, Host, Origin, CSRF and size checks. A `core:` key and `node:owner_quota` are owner-only and start
    nothing; a governed module key is signed by the core through the owner-unlock agent, or comes back `owner-locked`
    (hdash never signs and never reads a passphrase)."""
    key, value = obj.get("id"), obj.get("value")
    if not (isinstance(key, str) and SETTING_ID.match(key)) or not isinstance(value, str):
        return 400, {"ok": False, "error": {"code": "validation", "message": "id and a string value are required"}}
    if len(value) > VALUE_MAX or any(unicodedata.category(c) in ("Cc", "Zl", "Zp") for c in value):
        return 400, {"ok": False, "error": {"code": "validation", "message": "the value is too long or has control characters"}}
    if key.startswith("core:") or key == "node:owner_quota":
        return 403, {"ok": False, "error": {"code": "owner-only", "id": key,
                                            "message": "this key is changed by the owner on the operator's terminal, not here",
                                            "hint": "see its write_via line"}}
    with _write_lock:
        try:
            rc, doc = run_hconfig(["set", "--json", "--stdin", "--non-interactive", "--", key], stdin_text=value + "\n")
        except RuntimeError as e:
            return 502, {"ok": False, "error": {"code": "core-failed", "id": key, "message": clean_text(e, 200)}}
    if rc == 0 and doc.get("ok") is True and isinstance(doc.get("key"), dict):
        return 200, {"ok": True, "id": key, "changed": doc.get("changed") is True, "key": record_view(doc["key"]),
                     "warnings": [clean_text(w, 300) for w in (doc.get("warnings") or [])[:10]] if isinstance(doc.get("warnings"), list) else []}
    err = doc.get("error") if isinstance(doc.get("error"), dict) else {}
    code = err.get("code") if err.get("code") in ERROR_STATUS else "core-failed"
    status = 409 if rc == 5 else ERROR_STATUS[code]
    return status, {"ok": False, "error": {"code": "owner-locked" if rc == 5 else code, "id": key,
                                           "message": clean_text(err.get("message", "refused"), 300),
                                           "hint": clean_text(err.get("hint", ""), 400)}}


def local_routes():
    def modules(query):
        try:
            return 200, modules_view()
        except RuntimeError as e:
            return 502, {"error": str(e)}

    def module(query):
        name = parse_qs(query).get("name", [""])[0]
        try:
            view = module_view(name)
        except RuntimeError as e:
            return 502, {"error": str(e)}
        return (200, view) if view else (404, {"error": "no such module"})
    def workspace(query):
        name = parse_qs(query).get("name", [""])[0]
        try:
            view = workspace_view(name)
        except RuntimeError as e:
            return 502, {"error": clean_text(e, 200)}
        return (200, view) if view else (404, {"error": "no such workspace"})

    def settings(query):
        try:
            return settings_view(query)
        except RuntimeError as e:
            return 502, {"error": clean_text(e, 200)}
    return {"modules": modules, "module": module, "settings": settings, "workspace": workspace}


class Gateway:
    """Maps one dashboard `/api/<route>` call to the core. `v1` is a callable (path, query) -> (status, obj),
    `daemon` the same for the daemon's `/api/*`. Both are injected so tests need no live core."""

    def __init__(self, v1, daemon, local=None, writes=None):
        self.v1, self.daemon, self.local = v1, daemon, local or {}
        self.writes = writes or {}          # name -> callable(obj) -> (status, obj); the handler guards them first

    def write(self, name, obj):
        fn = self.writes.get(name)
        return fn(obj) if fn else (405, {"error": "read only"})

    def route(self, name, query):
        if name in LOCAL_ROUTES:                     # this node's own catalog: `?node=` is not forwarded
            fn = self.local.get(name)
            return fn(query) if fn else (404, {"error": "not found"})
        qs = parse_qs(query)
        if name in V1_READS and not qs.get("node", [""])[0]:
            if name == "item":                       # /api/item takes `sid`, /v1/item takes `id`
                query = urlencode({"id": qs.get("sid", [""])[0]})
            try:
                return self.v1(f"/v1/{name}", query)
            except Exception as e:
                return 502, {"error": f"module API unavailable: {e}"}
        try:
            return self.daemon(f"/api/{name}", query)
        except Exception as e:
            return 502, {"error": f"sync daemon unavailable: {e}"}


def make_handler(gateway, port, csrf_token=None, launch_token=None):
    """`csrf_token` and `launch_token` are fixed only by tests; a server makes its own per process (the launch token
    comes from the 0600 file `serve` writes). `/api/csrf` is handed out only against the launch token, so another OS
    account on the node (which can open 127.0.0.1 and set any header) gets no CSRF token and no write. Every non-GET route passes, in
    order, the Host check (DNS rebinding), an `Origin` equal to this listener's own origin (required, not optional),
    `Sec-Fetch-Site: same-origin` when the browser sends one, no `Tailscale-*` header (a Serve viewer arrives on loopback;
    writes stay on the device), a loopback source address, the CSRF token header (constant-time compare), a JSON
    content type and a bounded JSON object body. Only then is a write route looked up, so a probe that fails any
    check learns nothing about which writes exist."""
    allowed = {f"127.0.0.1:{port}", f"localhost:{port}", f"[::1]:{port}"}
    origins = {f"http://{h}" for h in allowed}
    token = csrf_token or secrets.token_urlsafe(32)
    launch = launch_token or secrets.token_urlsafe(32)
    slots = threading.BoundedSemaphore(MAX_CONCURRENT)

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "hdash"

        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json", extra=()):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Cache-Control", "no-store")
            for k, v in extra:
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)

        def _refuse(self, code, msg):
            self._send(code, {"error": msg}, extra=(("Allow", "GET, HEAD"),) if code == 405 else ())

        def _origin_ok(self, mutating):
            origin = self.headers.get("Origin")
            if origin is None:
                return not mutating                      # a write must say where it came from
            return origin.lower() in origins             # a stray or `null` Origin fails on any method

        def _site_ok(self, mutating):
            site = self.headers.get("Sec-Fetch-Site")
            return site is None or site == "same-origin" or (site == "none" and not mutating)

        def _serve(self):
            if (self.headers.get("Host") or "").lower() not in allowed:
                return self._refuse(403, "forbidden host")          # DNS rebinding: only the loopback name
            if not self._origin_ok(False) or not self._site_ok(False):
                return self._refuse(403, "forbidden origin")
            u = urlparse(self.path)
            if u.path == "/api/settings" and any(k.lower().startswith("tailscale-") for k in self.headers.keys()):
                return self._refuse(403, "forbidden: not a local request")   # settings are the operator's, never a Serve viewer's
            if u.path == CSRF_ROUTE:
                if not hmac.compare_digest((self.headers.get(LAUNCH_HEADER) or "").encode(), launch.encode()):
                    return self._refuse(403, "missing or wrong launch token: open the dashboard with `hv dash`")
                return self._send(200, {"token": token})
            if u.path in PAGES:
                name = PAGES[u.path]
                try:
                    body = (HERE / "dashboard" / name).read_bytes()
                except OSError:
                    return self._refuse(404, "dashboard asset missing")
                extra = (("Content-Security-Policy", CSP),) if name == "index.html" else ()
                return self._send(200, body, STATIC[name], extra)
            if u.path.startswith("/api/") and u.path[5:] in API_ROUTES:
                code, obj = gateway.route(u.path[5:], u.query)
                return self._send(code, obj)
            self._refuse(404, "not found")

        def _guarded(self):
            if not slots.acquire(blocking=False):
                return self._refuse(503, "server busy")
            try:
                self._serve()
            except Exception as e:  # never crash the handler thread
                self._refuse(500, str(e))
            finally:
                slots.release()

        do_GET = do_HEAD = _guarded

        def _no(self):
            self._refuse(405, "read only")

        do_OPTIONS = _no                                  # no CORS: a cross-origin preflight is never answered yes

        def _deny(self, code, msg):
            self.close_connection = True                  # the body was not read: do not parse it as the next request
            self._send(code, {"error": msg}, extra=(("Connection", "close"),) + ((("Allow", "GET, HEAD"),) if code == 405 else ()))

        def _mutate(self):
            if self.client_address[0] not in LOOPBACK:
                return self._deny(403, "loopback only")                # gate 6a: no peer or proxy source, whatever else is right
            if (self.headers.get("Host") or "").lower() not in allowed:
                return self._deny(403, "forbidden host")
            if not self._origin_ok(True) or not self._site_ok(True):
                return self._deny(403, "forbidden origin")
            if any(k.lower().startswith("tailscale-") for k in self.headers.keys()):
                return self._deny(403, "forbidden: not a local request")   # gate 6c: a Tailscale Serve viewer arrives on loopback
            if not hmac.compare_digest((self.headers.get(CSRF_HEADER) or "").encode(), token.encode()):
                return self._deny(403, "missing or wrong CSRF token")
            if (self.headers.get("Content-Type") or "").split(";")[0].strip().lower() != "application/json":
                return self._deny(415, "JSON only")
            try:
                n = int(self.headers.get("Content-Length") or "")
            except ValueError:
                return self._deny(411, "Content-Length required")
            if not 0 <= n <= MAX_BODY:
                return self._deny(413, "body too large")
            try:
                obj = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                return self._deny(400, "bad JSON")
            if not isinstance(obj, dict):
                return self._deny(400, "JSON object required")
            u = urlparse(self.path)
            if not u.path.startswith("/api/"):
                return self._deny(404, "not found")
            code, out = gateway.write(u.path[5:], obj)
            self._send(code, out)

        def _guarded_write(self):
            if not slots.acquire(blocking=False):
                return self._deny(503, "server busy")
            try:
                self._mutate()
            except Exception as e:
                self._deny(500, str(e))
            finally:
                slots.release()

        do_POST = do_PUT = do_DELETE = do_PATCH = _guarded_write

    return Handler


def make_server(gateway, port, launch_token=None):
    return ThreadingHTTPServer((BIND, port), make_handler(gateway, port, launch_token=launch_token))


# ── viewer mode (4.x P4): a read-only listener for allowlisted tailnet logins ─────────────────────────────────────────
# Design: hive-mind-private docs/design/dashboard-tailnet-access.md. The listener is a class of its own (`make_viewer_handler`)
# with one authorization path, the viewer gate; it never consults a source address, so a request from 127.0.0.1 (every
# request that arrives through `tailscale serve`) grants nothing by itself. It shares no budget with the operator listener.

VIEWER_PORT_DEFAULT = 9906       # clear of 9876-9880 (daemon + fallback range), 9886 (module API) and 9896 (operator port)
MODULE_API_PORT_DEFAULT = 9886
SERVE_HTTPS_PORT = 8443          # a dedicated Serve port, so sharing never overwrites another `tailscale serve` entry
LOGIN_HEADER = "Tailscale-User-Login"
FUNNEL_HEADER = "Tailscale-Funnel-Request"
VIEWER_SIGNATURE = {"listener": "viewer"}     # in every refusal; `share` and doctor probe for it
VIEWER_PAGES = ("/", "/index.html", "/dashboard", "/dashboard/", "/logo.svg", "/favicon.svg", "/app.js", "/app.css")
VIEWER_RECORDS_PATH = "/api/config/records"
VIEWER_ROUTES = {        # route -> the query parameters it takes; anything else (`node` above all) is a 403
    "overview": (), "tags": (), "audit": (), "verify": (), "peers": (),
    "search": ("q", "tag", "kind", "min_confidence", "limit", "offset", "sort", "status"),
    "related": ("kind", "id"), "item": ("sid",),
}
VIEWER_PARAM_MAX = 512
LOGIN_MAX = 256
VIEWER_SLOTS = 4                 # concurrent requests the viewer listener works on (the operator's is MAX_CONCURRENT)
VIEWER_MAX_CONNS = 32
VIEWER_RATE = (30, 3.0)          # per login: burst, then requests per second; unidentified traffic shares one key
VIEWER_UPSTREAM = (12, 2.0)      # all viewers together: burst, then calls per second hdash makes to the core for them
VIEWER_UPSTREAM_WAIT = 3.0
VIEWER_CACHE_TTL, VIEWER_CACHE_MAX = 5.0, 64
VIEWER_POLL = 2.0                # seconds between looks at the node config (share on/off, port)
VIEWER_TIMEOUT = 10
NO_LOGIN = "\x00none"            # the rate key of a request with no (or a malformed) login header
VIEWER_RECORD_FIELDS = ("id", "class", "type", "default", "values", "min", "max", "description", "value", "source")


def peers_file():
    return hive_home() / ".peers.json"


def viewer_settings(path=None):
    """`dashboard_share`, `dashboard_viewers` and `dashboard_viewer_port` from the node file, which `hv config node set`
    writes. Never raises: a missing, unreadable or mistyped file or port means sharing is off. Logins are lowercased."""
    try:
        cfg = json.loads(Path(path or peers_file()).read_text())
    except (OSError, ValueError):
        cfg = None
    cfg = cfg if isinstance(cfg, dict) else {}
    port = cfg.get("dashboard_viewer_port")
    valid = isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65535
    viewers = cfg.get("dashboard_viewers")
    viewers = sorted({v.lower() for v in viewers if isinstance(v, str) and 0 < len(v) <= LOGIN_MAX}) if isinstance(viewers, list) else []
    return {"share": cfg.get("dashboard_share") is True and (valid or port is None), "port": port if valid else VIEWER_PORT_DEFAULT,
            "port_set": valid, "viewers": viewers}


class SettingsCache:
    """`viewer_settings`, re-read only when the file changes, so an allowlist edit or `unshare` bites on the next request."""

    def __init__(self, path_fn=peers_file, reader=viewer_settings):
        self.path_fn, self.reader, self.sig, self.val = path_fn, reader, None, None
        self.lock = threading.Lock()

    def get(self):
        path = self.path_fn()
        try:
            st = os.stat(path)
            sig = (st.st_mtime_ns, st.st_size, st.st_ino)
        except OSError:
            sig = None
        with self.lock:
            if self.val is None or sig != self.sig:
                self.val, self.sig = self.reader(path), sig
            return self.val


def module_api_port():
    try:
        return int(os.environ.get("HIVE_MODULE_PORT") or MODULE_API_PORT_DEFAULT)
    except ValueError:
        return MODULE_API_PORT_DEFAULT


def viewer_port_problem(port, operator_port, daemon_live=None, module_api=None):
    """Why `port` must not be the viewer listener's (it is, or may be, a full-trust loopback listener), else None. The daemon
    falls back through `range(base, base + 5)` when its base port is squatted, so its live port can be any of them."""
    daemon_live = daemon_port() if daemon_live is None else daemon_live
    module_api = module_api_port() if module_api is None else module_api
    if not 1024 <= port <= 65535:
        return f"port {port} is outside 1024-65535"
    if port == operator_port:
        return f"port {port} is hdash's own operator port"
    if port == daemon_live:
        return f"port {port} is the sync daemon's live port"
    for base in sorted({DAEMON_PORT_DEFAULT, daemon_live}):
        if base <= port < base + 5:
            return f"port {port} is inside the daemon's fallback range {base}-{base + 4}"
    if port == module_api:
        return f"port {port} is the module API's port"
    return None


class Bucket:
    """A token bucket: `burst` tokens, refilled at `rate` per second."""

    def __init__(self, burst, rate, clock=time.monotonic):
        self.burst, self.rate, self.clock = burst, rate, clock
        self.tokens, self.at = float(burst), clock()

    def take(self):
        now = self.clock()
        self.tokens = min(self.burst, self.tokens + (now - self.at) * self.rate)
        self.at = now
        if self.tokens >= 1:
            self.tokens -= 1
            return True
        return False


class KeyedLimiter:
    """One `Bucket` per key, at most `max_keys` of them (the rest share one), under a lock."""

    def __init__(self, burst, rate, max_keys=256, clock=time.monotonic):
        self.burst, self.rate, self.max_keys, self.clock = burst, rate, max_keys, clock
        self.buckets, self.lock = {}, threading.Lock()

    def allow(self, key):
        with self.lock:
            if key not in self.buckets and len(self.buckets) >= self.max_keys:
                key = "\x00overflow"
            b = self.buckets.get(key)
            if b is None:
                b = self.buckets[key] = Bucket(self.burst, self.rate, self.clock)
            return b.take()


def viewer_login(headers):
    """The one `Tailscale-User-Login`, lowercased, or None when it is absent, repeated, empty, over-long or has
    whitespace or control characters. A tagged device and Funnel traffic carry none."""
    values = headers.get_all(LOGIN_HEADER) or []
    if len(values) != 1:
        return None
    v = values[0].strip()
    if not v or len(v) > LOGIN_MAX or any(c.isspace() or unicodedata.category(c) in ("Cc", "Cf") for c in v):
        return None
    return v.lower()


def viewer_query(route, query):
    """The sanitized query string for a viewer read, or None to refuse. Only the route's own parameters pass, each once with
    a bounded value, so `node=` (the per-node view) can never reach the core. `/api/peers` is always `probe=0`."""
    if route == "peers":
        return "probe=0"
    try:
        qs = parse_qs(query, keep_blank_values=True, strict_parsing=False, max_num_fields=16)
    except ValueError:
        return None
    clean = []
    for k, vals in qs.items():
        if k not in VIEWER_ROUTES[route] or len(vals) != 1 or len(vals[0]) > VIEWER_PARAM_MAX:
            return None
        clean.append((k, vals[0]))
    return urlencode(sorted(clean))


def viewer_record(rec):
    """One hconfig record as a viewer may see it, or None. A governed value whose key is not `identifying`, or a non-secret module
    value hconfig labels `viewer` (its panel has `viewer: true`). Never a `node:` key, a secret, an identifying value; only the
    fields in VIEWER_RECORD_FIELDS, so `set_by`, `write_via`, `warnings`, `env` and the writer never leave. A record missing
    `secret` or `identifying` is refused (fail closed)."""
    if not isinstance(rec, dict) or not isinstance(rec.get("id"), str) or rec["id"].startswith("node:"):
        return None
    if rec.get("class") not in ("governed", "module") or rec.get("visibility") != "viewer":
        return None
    if rec.get("secret") is not False or rec.get("identifying") is not False:
        return None
    out = {}
    for k in VIEWER_RECORD_FIELDS:
        if k in rec:
            out[k] = clean_text(rec[k], 100) if k == "id" else (
                [clean_text(x, 100) for x in rec[k][:100]] if k == "values" and isinstance(rec[k], list) else
                clean_text(rec[k], 400) if k in ("description", "source", "type", "class") and isinstance(rec[k], str) else
                _value_view(rec[k]) if k in ("default", "value", "min", "max") else None)
    return out


def viewer_records():
    """`GET /api/config/records`: the viewer-visible hconfig records (this node), nothing else from hconfig."""
    try:
        rc, doc = run_hconfig(["list", "--json"])
    except RuntimeError:
        return 502, {"error": "settings unavailable"}
    if rc != 0 or doc.get("ok") is not True or not isinstance(doc.get("keys"), list):
        return 502, {"error": "settings unavailable"}
    return 200, {"schema": 1, "keys": [r for r in map(viewer_record, doc["keys"]) if r]}


class ViewerBackend:
    """What the viewer listener answers from: the operator's `Gateway` (hdash's own fetches), behind a short cache, one
    upstream call at a time and its own call budget, so a viewer flood cannot reach the daemon's 127.0.0.1 bucket or its
    32 slots faster than that budget. An upstream error is a bare status: no path, port or exception text reaches a viewer."""

    def __init__(self, gateway, records=viewer_records, ttl=VIEWER_CACHE_TTL, clock=time.monotonic):
        self.gateway, self.records, self.ttl, self.clock = gateway, records, ttl, clock
        self.cache, self.cache_lock, self.upstream = {}, threading.Lock(), threading.Lock()
        self.budget = Bucket(*VIEWER_UPSTREAM, clock=clock)
        self.calls = 0                       # upstream calls made on viewers' behalf (tests read it)

    def _cached(self, key):
        with self.cache_lock:
            hit = self.cache.get(key)
            return hit[1:] if hit and hit[0] > self.clock() else None

    def _store(self, key, code, obj):
        with self.cache_lock:
            now = self.clock()
            for k in [k for k, v in self.cache.items() if v[0] <= now]:
                del self.cache[k]
            while len(self.cache) >= VIEWER_CACHE_MAX:
                del self.cache[min(self.cache, key=lambda k: self.cache[k][0])]
            self.cache[key] = (now + self.ttl, code, obj)

    def get(self, route, query=""):
        key = (route, query)
        hit = self._cached(key)
        if hit:
            return hit
        if not self.upstream.acquire(timeout=VIEWER_UPSTREAM_WAIT):
            return 503, {"error": "busy"}
        try:
            hit = self._cached(key)                  # another viewer may have filled it while this one waited
            if hit:
                return hit
            if not self.budget.take():
                return 429, {"error": "busy"}
            self.calls += 1
            try:
                code, obj = self.records() if route == "config/records" else self.gateway.route(route, query)
            except Exception:
                code, obj = 502, None
            if code != 200 or not isinstance(obj, (dict, list)):
                code, obj = (code if code in (400, 404, 429, 502, 503) else 502), {"error": "unavailable"}
            self._store(key, code, obj)
            return code, obj
        finally:
            self.upstream.release()


def make_viewer_handler(backend, settings, limiter=None, slots=None):
    """The viewer listener's handler. Its single gate, for every request: take a slot (503), charge the per-login rate (429), then
    require sharing on, exactly one `Tailscale-User-Login` on the allowlist (case-insensitive), no Funnel marker, method GET, no
    body and a path in the read-only subset (403 for each). The 403 body is `{"listener": "viewer"}`. There is no POST handler,
    and nothing here reads the source address: a loopback source is not an identity."""
    limiter = limiter or KeyedLimiter(*VIEWER_RATE)
    slots = slots or threading.BoundedSemaphore(VIEWER_SLOTS)

    class ViewerHandler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "hdash-viewer"
        timeout = VIEWER_TIMEOUT

        def log_message(self, *a):
            pass

        def _send(self, code, obj, ctype="application/json", close=False):
            data = obj if isinstance(obj, bytes) else json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Cache-Control", "no-store")
            if ctype.startswith("text/html"):
                self.send_header("Content-Security-Policy", CSP)
            if close:
                self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(data)

        def _refuse(self, code, msg):
            self.close_connection = True                 # a body we never read must not be parsed as the next request
            self._send(code, {**VIEWER_SIGNATURE, "error": msg}, close=True)

        def _handle(self):
            if not slots.acquire(blocking=False):
                return self._refuse(503, "server busy")
            try:
                login = viewer_login(self.headers)
                if not limiter.allow(login or NO_LOGIN):          # charged before any refusal below
                    return self._refuse(429, "rate limited")
                cfg = settings.get()
                if not (cfg["share"] and login in cfg["viewers"]) or self.headers.get(FUNNEL_HEADER) is not None:
                    return self._refuse(403, "forbidden")
                if self.command != "GET" or self.headers.get("Content-Length") or self.headers.get("Transfer-Encoding"):
                    return self._refuse(403, "forbidden")
                u = urlparse(self.path)
                if u.path in VIEWER_PAGES:
                    name = PAGES[u.path]
                    try:
                        body = (HERE / "dashboard" / name).read_bytes()
                    except OSError:
                        return self._refuse(403, "forbidden")
                    return self._send(200, body, STATIC[name])
                if u.path == VIEWER_RECORDS_PATH:
                    code, obj = backend.get("config/records")
                elif u.path.startswith("/api/") and u.path[5:] in VIEWER_ROUTES:
                    q = viewer_query(u.path[5:], u.query)
                    if q is None:
                        return self._refuse(403, "forbidden")
                    code, obj = backend.get(u.path[5:], q)
                else:
                    return self._refuse(403, "forbidden")
                self._send(code, obj)
            except Exception:                            # never crash the handler thread, never echo the cause
                self._refuse(500, "error")
            finally:
                slots.release()

        do_GET = do_HEAD = do_POST = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = _handle

    return ViewerHandler


class ViewerServer(ThreadingHTTPServer):
    """Loopback only, with a cap on open connections (a slow client holds a thread, not the listener)."""
    daemon_threads = True

    def __init__(self, port, handler, max_conns=VIEWER_MAX_CONNS):
        self.conns = threading.BoundedSemaphore(max_conns)
        super().__init__((BIND, port), handler)

    def process_request(self, request, client_address):
        if not self.conns.acquire(blocking=False):
            return self.shutdown_request(request)
        super().process_request(request, client_address)

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.conns.release()


class ViewerManager:
    """Owns the viewer listener for this hdash process: binds it when the node config says share on (and the port is safe),
    stops it when the config says off or the port changes, and never falls back to another port. A port that is taken or
    unsafe leaves sharing off and is reported in `error`; doctor warns. hdash stopping stops it (it is hdash's thread)."""

    def __init__(self, backend, operator_port, settings=None, log=None, make=ViewerServer):
        self.backend, self.operator_port = backend, operator_port
        self.settings = settings or SettingsCache()
        self.log, self.make = log or (lambda m: print(m, file=sys.stderr, flush=True)), make
        self.handler = make_viewer_handler(backend, self.settings)
        self.server = self.thread = None
        self.port = None
        self.error = None
        self.stopping = threading.Event()

    def reconcile(self):
        cfg = self.settings.get()
        if self.server and (not cfg["share"] or cfg["port"] != self.port):
            self.stop_listener()
        if not cfg["share"] or self.server:
            self.error = None if not cfg["share"] else self.error
            return
        problem = viewer_port_problem(cfg["port"], self.operator_port)
        if problem is None:
            try:
                self.server = self.make(cfg["port"], self.handler)
            except OSError as e:
                problem = f"cannot bind 127.0.0.1:{cfg['port']}: {e.strerror or type(e).__name__}"
        if problem is not None:
            if problem != self.error:
                self.log(f"hdash: viewer listener off: {problem}")
            self.error = problem
            return
        self.error, self.port = None, cfg["port"]
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        self.log(f"hdash: viewer listener on 127.0.0.1:{self.port} (read-only, {len(cfg['viewers'])} login(s))")

    def stop_listener(self):
        srv, self.server, self.port = self.server, None, None
        if srv:
            srv.shutdown()
            srv.server_close()
            self.log("hdash: viewer listener off")

    def run(self, interval=VIEWER_POLL):
        while not self.stopping.is_set():
            try:
                self.reconcile()
            except Exception as e:
                self.log(f"hdash: viewer reconcile failed: {type(e).__name__}")
            self.stopping.wait(interval)
        self.stop_listener()

    def stop(self):
        self.stopping.set()
        self.stop_listener()


def probe_viewer(port, timeout=3):
    """What answers an unauthenticated GET on 127.0.0.1:<port>: ("viewer", "") when it is the viewer listener's signature
    reply (403 with {"listener": "viewer"}), ("other", detail) for anything else (an operator listener answers the dashboard
    page 200 to a loopback caller), ("down", detail) when nothing answers. This is the load-bearing check."""
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k):
            return None
    req = urllib.request.Request(f"http://127.0.0.1:{port}/", headers={"Host": f"127.0.0.1:{port}"})
    try:
        with urllib.request.build_opener(NoRedirect).open(req, timeout=timeout) as r:
            return "other", f"answered {r.status}"
    except urllib.error.HTTPError as e:
        try:
            doc = json.loads(e.read(4096))
        except ValueError:
            doc = None
        if e.code == 403 and isinstance(doc, dict) and doc.get("listener") == "viewer":
            return "viewer", ""
        return "other", f"answered {e.code}"
    except (OSError, ValueError) as e:
        return "down", type(e).__name__


def tailscale(args, timeout=20):
    """Run the `tailscale` CLI (argv, no shell): (exit code, stdout, stderr). RuntimeError when it is absent or hangs."""
    exe = shutil.which("tailscale")
    if not exe:
        raise RuntimeError("the tailscale command is not installed on this node")
    try:
        p = subprocess.run([exe] + list(args), capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        raise RuntimeError(f"tailscale did not answer: {type(e).__name__}") from e
    return p.returncode, p.stdout, p.stderr


def tailscale_json(args):
    rc, out, err = tailscale(args)
    if rc != 0:
        raise RuntimeError(f"tailscale {' '.join(args[:2])} failed: {clean_text(err or out or f'exit {rc}', 200)}")
    try:
        doc = json.loads(out or "{}")
    except ValueError as e:
        raise RuntimeError("tailscale printed something that is not JSON") from e
    if not isinstance(doc, dict):
        raise RuntimeError("tailscale printed something that is not an object")
    return doc


def front_end(serve_status, https_port=SERVE_HTTPS_PORT):
    """What `tailscale serve status --json` says about our HTTPS port: {served, targets: [(path, proxy)], other, funnel}. `other`
    is a handler that is not a plain proxy (static text or a path), `funnel` that the front end is public (Funnel is per Serve
    HTTPS port, so the port is the thing to inspect, not the backend)."""
    suffix = f":{https_port}"
    dicts = lambda k: serve_status.get(k) if isinstance(serve_status.get(k), dict) else {}
    out = {"served": str(https_port) in dicts("TCP"), "targets": [], "other": False,
           "funnel": any(v is True and str(k).endswith(suffix) for k, v in dicts("AllowFunnel").items())}
    for host, ent in dicts("Web").items():
        if not str(host).endswith(suffix):
            continue
        out["served"] = True
        handlers = ent.get("Handlers") if isinstance(ent, dict) and isinstance(ent.get("Handlers"), dict) else {}
        out["other"] = out["other"] or not handlers
        for path, h in handlers.items():
            prox = h.get("Proxy") if isinstance(h, dict) else None
            if isinstance(prox, str):
                out["targets"].append((path, prox.rstrip("/")))
            else:
                out["other"] = True
    return out


def serves_viewer(fe, port):
    """True when the front end is exactly one proxy of `/` to the viewer listener."""
    return fe["served"] and not fe["other"] and fe["targets"] == [("/", f"http://127.0.0.1:{port}")]


def tailnet_identity(status):
    """(login, DNS name) of this device from `tailscale status --json`; either may be ''."""
    me = status.get("Self") if isinstance(status.get("Self"), dict) else {}
    users = status.get("User") if isinstance(status.get("User"), dict) else {}
    user = users.get(str(me.get("UserID")))
    login = user.get("LoginName") if isinstance(user, dict) else ""
    return (login.lower() if isinstance(login, str) else ""), str(me.get("DNSName") or "").rstrip(".")


def hv_argv():
    exe = shutil.which("hv")
    return [exe] if exe else [sys.executable, str(hive_home() / "hv")]


def config_node_set(key, value, timeout=60):
    """`hv config node set <key> <value>`: the one writer of the node file. hdash never writes `.peers.json` itself."""
    try:
        p = subprocess.run(hv_argv() + ["config", "node", "set", key, value], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        raise RuntimeError(f"could not run `hv config node set {key}`: {type(e).__name__}") from e
    if p.returncode != 0:
        raise RuntimeError(f"`hv config node set {key}` failed: {clean_text(p.stdout or p.stderr, 200)}")


def exposure_results(cfg, operator_port, ts=tailscale_json, probe=probe_viewer):
    """The `dashboard-exposure` doctor rows for node config `cfg`. Fails on a Funnel-enabled 8443 front end, on a Serve target
    that is not the viewer listener, and on any port that is (or may be) a full-trust listener; warns when sharing is on with
    no viewer listener bound. Advisory otherwise."""
    check, port = "dashboard-exposure", cfg["port"]
    rows = []
    try:
        fe = front_end(ts(["serve", "status", "--json"]))
    except RuntimeError as e:
        fe = None
        if cfg["share"]:
            rows.append({"level": "warn", "check": check, "message": f"cannot read the Serve front end: {clean_text(e, 200)}"})
    if fe and fe["funnel"]:
        rows.append({"level": "fail", "check": check, "fix_hint": f"tailscale funnel --https={SERVE_HTTPS_PORT} off",
                     "message": f"Funnel is on for the HTTPS {SERVE_HTTPS_PORT} front end: the dashboard viewer is reachable from the internet"})
    if not cfg["share"]:
        if fe and fe["served"] and any(t[1].endswith(f":{port}") for t in fe["targets"]):
            rows.append({"level": "warn", "check": check, "fix_hint": "hdash unshare",
                         "message": f"sharing is off but Serve HTTPS {SERVE_HTTPS_PORT} still points at 127.0.0.1:{port}"})
        return rows or [{"level": "ok", "check": check, "message": "sharing is off"}]
    problem = viewer_port_problem(port, operator_port)
    if problem:
        rows.append({"level": "fail", "check": check, "message": f"the viewer {problem}", "fix_hint": "hdash share --port <other port>"})
    state, detail = probe(port)
    if state == "other":
        rows.append({"level": "fail", "check": check, "message": f"127.0.0.1:{port} is not the viewer listener ({detail})",
                     "fix_hint": "hdash unshare; hdash share --port <other port>"})
    elif state == "down":
        rows.append({"level": "warn", "check": check, "message": f"sharing is on but nothing listens on 127.0.0.1:{port} (viewers get 502)",
                     "fix_hint": "the port may be taken; hive-mind module status hdash"})
    if fe is not None:
        if fe["served"] and not serves_viewer(fe, port):
            rows.append({"level": "fail", "check": check, "fix_hint": "hdash unshare",
                         "message": f"Serve HTTPS {SERVE_HTTPS_PORT} does not point only at the viewer listener 127.0.0.1:{port}: {fe['targets'] or 'a non-proxy handler'}"})
        elif not fe["served"]:
            rows.append({"level": "warn", "check": check, "fix_hint": "hdash share",
                         "message": f"sharing is on but nothing serves HTTPS {SERVE_HTTPS_PORT}"})
    if not any(r["level"] != "ok" for r in rows):
        rows.append({"level": "ok", "check": check, "message": f"sharing on for {len(cfg['viewers'])} login(s) via 127.0.0.1:{port}"})
    return rows


def cmd_doctor(args):
    print(json.dumps({"schema": 1, "results": exposure_results(viewer_settings(), load_port())}))
    return 0


def share(allow=(), port=None, *, ts=tailscale, tsj=tailscale_json, write=config_node_set, read=viewer_settings,
          probe=probe_viewer, operator_port=None, wait=10.0, sleep=time.sleep, out=print):
    """`hdash share [--allow LOGIN]... [--port N]`: check, switch the listener on, probe it, and only then point Serve at it.
    Returns the exit code. Any failing check aborts before the Serve config is touched (a node-config change made on the way is
    put back)."""
    operator_port = load_port() if operator_port is None else operator_port
    cfg = read()
    port = port or cfg["port"]
    problem = viewer_port_problem(port, operator_port)
    if problem:
        out(f"hdash: refusing to share: {problem}")
        return 1
    try:
        status = tsj(["status", "--json"])
        fe = front_end(tsj(["serve", "status", "--json"]))
    except RuntimeError as e:
        out(f"hdash: {e}")
        return 1
    login, dns = tailnet_identity(status)
    if fe["funnel"]:
        out(f"hdash: refusing to share: Funnel is on for HTTPS {SERVE_HTTPS_PORT}; turn it off first: tailscale funnel --https={SERVE_HTTPS_PORT} off")
        return 1
    ours = serves_viewer(fe, port)
    if fe["served"] and not ours:
        out(f"hdash: refusing to share: HTTPS {SERVE_HTTPS_PORT} is already served by something else ({fe['targets'] or 'a non-proxy handler'})")
        return 1
    viewers = sorted(set(cfg["viewers"]) | {a.strip().lower() for a in allow if a.strip()} | ({login} if not cfg["viewers"] and login else set()))
    if not viewers:
        out("hdash: no login to allow: pass --allow <login> (this device's Tailscale login could not be read)")
        return 1
    changed = []
    try:
        if viewers != cfg["viewers"]:
            write("dashboard_viewers", json.dumps(viewers))
        if port != cfg["port"] or (port != VIEWER_PORT_DEFAULT and not cfg["port_set"]):
            write("dashboard_viewer_port", str(port))
            changed.append(("dashboard_viewer_port", cfg["port"] if cfg["port_set"] else None))
        if not cfg["share"]:
            write("dashboard_share", "true")
            changed.append(("dashboard_share", False))
    except RuntimeError as e:
        out(f"hdash: {e}")
        return 1
    deadline, state, detail = time.monotonic() + wait, "down", ""
    while True:
        state, detail = probe(port)
        if state == "viewer" or time.monotonic() >= deadline:
            break
        sleep(0.5)
    if state != "viewer":
        why = ("the port answers something other than the viewer listener (" + detail + "): it may be a full-trust listener"
               if state == "other" else "nothing answered on it; is hdash running? (hive-mind module status hdash)")
        out(f"hdash: refusing to share: the loopback probe of 127.0.0.1:{port} failed: {why}")
        for key, old in reversed(changed):
            try:
                write(key, "false" if key == "dashboard_share" else str(old if old else VIEWER_PORT_DEFAULT))
            except RuntimeError:
                out(f"hdash: could not put {key} back; run `hdash unshare`")
        return 1
    if not ours:
        rc, so, se = ts(["serve", "--bg", f"--https={SERVE_HTTPS_PORT}", f"http://127.0.0.1:{port}"])
        if rc != 0:
            out(f"hdash: tailscale serve failed: {clean_text(se or so, 200)}")
            return 1
    out(f"Sharing the dashboard read-only with: {', '.join(viewers)}")
    out(f"  URL: https://{dns or '<this-device>.<tailnet>.ts.net'}:{SERVE_HTTPS_PORT}")
    return 0


def unshare(*, ts=tailscale, tsj=tailscale_json, write=config_node_set, read=viewer_settings, out=print):
    """`hdash unshare`: turn the 8443 front end off (only when it is ours), then clear `dashboard_share`; the listener stops
    within a couple of seconds. Returns the exit code."""
    cfg, rc = read(), 0
    try:
        fe = front_end(tsj(["serve", "status", "--json"]))
    except RuntimeError as e:
        out(f"hdash: {e}; clearing dashboard_share anyway (check `tailscale serve status`)")
        fe, rc = None, 1
    if fe and fe["served"]:
        if serves_viewer(fe, cfg["port"]):
            code, so, se = ts(["serve", f"--https={SERVE_HTTPS_PORT}", "off"])
            if code != 0:
                out(f"hdash: tailscale serve off failed: {clean_text(se or so, 200)}")
                rc = 1
        else:
            out(f"hdash: HTTPS {SERVE_HTTPS_PORT} is served by something that is not the viewer listener; left alone")
            rc = 1
    try:
        write("dashboard_share", "false")
    except RuntimeError as e:
        out(f"hdash: {e}")
        return 1
    out("Sharing is off." if rc == 0 else "Sharing is off in the node config; see above.")
    return rc


def viewers_report(*, tsj=tailscale_json, read=viewer_settings, out=print, as_json=False):
    """`hdash viewers`: the allowlist and the Serve status. A read."""
    cfg = read()
    try:
        fe = front_end(tsj(["serve", "status", "--json"]))
        serve = ("funnel ON" if fe["funnel"] else "points at the viewer listener" if serves_viewer(fe, cfg["port"])
                 else "not served" if not fe["served"] else "serves something else")
    except RuntimeError as e:
        serve = f"unknown ({clean_text(e, 100)})"
    if as_json:
        out(json.dumps({"schema": 1, "share": cfg["share"], "port": cfg["port"], "viewers": cfg["viewers"], "serve": serve}))
    else:
        out(f"sharing: {'on' if cfg['share'] else 'off'}   viewer port: 127.0.0.1:{cfg['port']}   Serve HTTPS {SERVE_HTTPS_PORT}: {serve}")
        for v in cfg["viewers"] or ["(no logins listed)"]:
            out(f"  {v}")
    return 0


def cmd_serve(args):
    port = load_port()
    try:
        client = make_v1_client()
    except RuntimeError as e:
        print(f"hdash: {e}", file=sys.stderr)
        return 1
    dport = daemon_port()
    gateway = Gateway(lambda p, q: client.request("GET", p, q),
                      lambda p, q: daemon_get(p, q, dport), local_routes(), {"settings": write_setting})
    try:
        launch = write_launch_token()
    except OSError as e:
        print(f"hdash: cannot write the launch token {launch_token_path()}: {e}", file=sys.stderr)
        return 1
    srv = make_server(gateway, port, launch)
    print(f"hdash: serving http://127.0.0.1:{port}/", flush=True)
    viewer = ViewerManager(ViewerBackend(gateway), port)       # follows this process: bound while `dashboard_share` is on
    threading.Thread(target=viewer.run, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        viewer.stop()
    return 0


def cmd_dash(args):
    port = load_port()
    local = f"http://127.0.0.1:{port}/"
    launch = read_launch_token()
    url = f"{local}#k={launch}" if launch else local
    up = False
    try:
        urllib.request.urlopen(local + "app.css", timeout=2).close()
        up = True
    except Exception:
        pass
    print("HiveMind dashboard")
    print(f"  Local:    {local}")
    if not launch:
        print(f"\n  ⚠ No launch token ({launch_token_path()}): the page loads but cannot save settings until hdash is running.")
    if not up:
        print("\n  ⚠ The hdash service isn't answering on this port — the dashboard won't load yet.")
        print("    Check it with `hive-mind module status hdash`, then retry `hv dash`.")
        return 1
    if args.print_only:
        return 0
    opener = next(([c] for c in ("termux-open-url", "xdg-open", "open") if shutil.which(c)), None)
    if opener:
        try:
            page = write_open_page(url) if launch else None
            subprocess.Popen(opener + [page.as_uri() if page else local], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if page:
                remove_open_page_later(page)
            print("\n  Opening in your browser…")
            return 0
        except OSError:
            pass
    print("\n  (Couldn't auto-open a browser — open the Local URL above.)")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="hdash", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve", help="run the dashboard service (the module unit does this)")
    d = sub.add_parser("dash", help="print the dashboard URL and open it in a browser")
    d.add_argument("--print", dest="print_only", action="store_true", help="print the URL only; do not open a browser")
    sh = sub.add_parser("share", help="share the dashboard read-only with tailnet logins")
    sh.add_argument("--allow", action="append", default=[], metavar="LOGIN", help="add a viewer (default: this device's Tailscale login)")
    sh.add_argument("--port", type=int, help=f"viewer listener port on 127.0.0.1 (default {VIEWER_PORT_DEFAULT})")
    sub.add_parser("unshare", help="stop sharing the dashboard")
    v = sub.add_parser("viewers", help="list the viewer allowlist and the Serve status")
    v.add_argument("--json", action="store_true")
    sub.add_parser("doctor", help="the dashboard-exposure check (the module doctor slot runs this)")
    args = p.parse_args(argv)
    return {"serve": cmd_serve, "dash": cmd_dash, "doctor": cmd_doctor,
            "share": lambda a: share(a.allow, a.port), "unshare": lambda a: unshare(),
            "viewers": lambda a: viewers_report(as_json=a.json)}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
